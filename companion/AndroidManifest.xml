<?xml version="1.0" encoding="utf-8"?>
<!--
  LinkDeck Pendamping: pendengar notifikasi + status baterai untuk LinkDeck di laptop.
  Dihubungi LinkDeck lewat adb (soket lokal "linkdeck_companion"); tidak memakai internet.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="id.linkdeck.companion">

    <!-- nama aplikasi pengirim notifikasi (Android 11+ menyembunyikan daftar aplikasi tanpa izin ini) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".NotifService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
